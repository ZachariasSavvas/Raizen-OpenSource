{
  "Urls": "http://0.0.0.0:5002",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=raizen;Username=raizen;Password=CHANGE_ME;Maximum Pool Size=50;Minimum Pool Size=5;Connection Idle Lifetime=300"
  },

  "Security": {
    "EncryptionKey": "CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY"
  },

  "RaizenApi": {
    "BaseUrl": "http://localhost:5001"
  },

  "AgentDeployment": {
    "ServerUrl": "https://raizen.contoso.com:5001",
    "InstallerPath": ""
  },

  "RequestLimits": {
    "MaxPerUserPerHour": 20
  },

  "AllowedHosts": "*",

  "ForwardedHeaders": {
    "ForwardedForHeaderName": "X-Forwarded-For",
    "ForwardedProtoHeaderName": "X-Forwarded-Proto"
  }
}
