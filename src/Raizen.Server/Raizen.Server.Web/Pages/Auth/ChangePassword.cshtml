@page
@model Raizen.Server.Web.Pages.Auth.ChangePasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var isDark = string.Equals(HttpContext.Request.Cookies["rz-theme"], "dark", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en"@(isDark ? " data-theme=\"dark\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Password | Raizen</title>
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.css" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: #f4f6fb;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
        }
        .login-wrap { width: 100%; max-width: 420px; padding: 16px; }
        .login-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 32px rgba(0,0,0,.10);
            padding: 44px 40px 36px;
        }
        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        .login-logo img { width: 44px; height: 44px; object-fit: contain; border-radius: 8px; }
        .login-logo span { font-size: 1.6rem; font-weight: 700; color: #111827; }
        .login-subtitle { text-align: center; color: #6b7280; font-size: 0.875rem; margin-bottom: 32px; }
        .form-label { font-weight: 600; font-size: 0.85rem; color: #374151; }
        .form-control { border-radius: 8px; border: 1px solid #d1d5db; padding: 10px 14px; font-size: 0.9rem; }
        .form-control:focus { border-color: #4f8ef7; box-shadow: 0 0 0 3px rgba(79,142,247,.15); }
        .btn-primary-rz {
            background: #4f8ef7;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-weight: 600;
            padding: 11px;
            font-size: 0.95rem;
            width: 100%;
            cursor: pointer;
            transition: opacity .15s;
        }
        .btn-primary-rz:hover { opacity: .88; }
        .notice-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 0.875rem;
            color: #1e40af;
            margin-bottom: 24px;
        }
        /* Dark mode */
        [data-theme="dark"] body { background: #0d1117; color: #e6edf3; }
        [data-theme="dark"] .login-card { background: #161b22; box-shadow: 0 4px 32px rgba(0,0,0,.4); }
        [data-theme="dark"] .login-logo span { color: #e6edf3; }
        [data-theme="dark"] .login-subtitle { color: #8b949e; }
        [data-theme="dark"] .form-label { color: #c9d1d9; }
        [data-theme="dark"] .form-control { background: #0d1117; border-color: #30363d; color: #e6edf3; }
        [data-theme="dark"] .notice-box { background: #0c2d6b; border-color: #1e40af; color: #93c5fd; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-logo">
                <img src="/images/raizen.jpg" alt="Raizen" onerror="this.style.display='none'" />
                <span>Raizen</span>
            </div>
            <p class="login-subtitle">Set Your Password</p>

            <div class="notice-box">
                <i class="bi bi-info-circle-fill me-1"></i>
                For security, please set a new password before continuing.
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background:#fee2e2;color:#991b1b;border-radius:8px;padding:10px 14px;font-size:.875rem;margin-bottom:20px;">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div><i class="bi bi-exclamation-triangle-fill me-1"></i>@e.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="NewPassword">New Password</label>
                    <input id="NewPassword" asp-for="NewPassword" type="password" class="form-control"
                           autocomplete="new-password" autofocus placeholder="Minimum 8 characters" />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="ConfirmPassword">Confirm Password</label>
                    <input id="ConfirmPassword" asp-for="ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" placeholder="Repeat your new password" />
                </div>
                <button type="submit" class="btn-primary-rz">
                    <i class="bi bi-check2-circle me-1"></i> Save &amp; Continue
                </button>
            </form>
        </div>
    </div>
</body>
</html>
