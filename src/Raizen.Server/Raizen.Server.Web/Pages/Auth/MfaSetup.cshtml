@page
@model Raizen.Server.Web.Pages.Auth.MfaSetupModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var isDark = string.Equals(HttpContext.Request.Cookies["rz-theme"], "dark", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en"@(isDark ? " data-theme=\"dark\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Up Two-Factor Authentication | Raizen</title>
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.css" />
    <style>
        body {
            display: flex; align-items: center; justify-content: center;
            min-height: 100vh; background: #f4f6fb;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; margin: 0;
        }
        .setup-wrap { width: 100%; max-width: 520px; padding: 16px; }
        .setup-card {
            background: #fff; border-radius: 16px;
            box-shadow: 0 4px 32px rgba(0,0,0,.10); padding: 40px;
        }
        .logo { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 6px; }
        .logo img { width: 40px; height: 40px; object-fit: contain; border-radius: 8px; }
        .logo span { font-size: 1.5rem; font-weight: 700; color: #111827; }
        .subtitle { text-align: center; color: #6b7280; font-size: .875rem; margin-bottom: 28px; }
        .step-badge {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 50%; background: #4f8ef7;
            color: #fff; font-size: .8rem; font-weight: 700; flex-shrink: 0;
        }
        .form-control { border-radius: 8px; border: 1px solid #d1d5db; padding: 10px 14px; font-size: .9rem; }
        .form-control:focus { border-color: #4f8ef7; box-shadow: 0 0 0 3px rgba(79,142,247,.15); }
        .btn-primary-full {
            background: #4f8ef7; border: none; border-radius: 8px; color: #fff;
            font-weight: 600; padding: 11px; font-size: .95rem; width: 100%;
            cursor: pointer; transition: opacity .15s;
        }
        .btn-primary-full:hover { opacity: .88; }
        .alert-error { background: #fee2e2; color: #991b1b; border-radius: 8px; padding: 10px 14px; font-size: .875rem; margin-bottom: 16px; }
        .key-box { background: #f3f4f6; border-radius: 8px; padding: 10px 14px; font-family: monospace; font-size: .85rem; letter-spacing: .08em; word-break: break-all; }
        .totp-input { font-size: 1.6rem; letter-spacing: .5rem; text-align: center; font-weight: 600; }
        .deadline-banner { background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px; padding: 10px 14px; font-size: .82rem; color: #92400e; margin-bottom: 20px; }
        /* Dark mode */
        [data-theme="dark"] body { background: #0d1117; color: #e6edf3; }
        [data-theme="dark"] .setup-card { background: #161b22; box-shadow: 0 4px 32px rgba(0,0,0,.4); }
        [data-theme="dark"] .logo span { color: #e6edf3; }
        [data-theme="dark"] .subtitle { color: #8b949e; }
        [data-theme="dark"] .form-control { background: #0d1117; border-color: #30363d; color: #e6edf3; }
        [data-theme="dark"] .alert-error { background: #3b0d0d; color: #f87171; }
        [data-theme="dark"] .key-box { background: #0d1117; color: #e6edf3; }
        [data-theme="dark"] .deadline-banner { background: #3d2e00; border-color: #92400e; color: #fbbf24; }
    </style>
</head>
<body>
    <div class="setup-wrap">
        <div class="setup-card">
            <div class="logo">
                <img src="/images/raizen.jpg" alt="Raizen" onerror="this.style.display='none'" />
                <span>Raizen</span>
            </div>
            <p class="subtitle"><i class="bi bi-shield-lock me-1"></i>Set Up Two-Factor Authentication</p>

            @if (Model.DaysLeft.HasValue)
            {
                <div class="deadline-banner">
                    <i class="bi bi-clock me-1"></i>
                    <strong>@Model.DaysLeft day@(Model.DaysLeft == 1 ? "" : "s") remaining</strong>
                    to complete MFA enrolment. After this deadline you will not be able to skip this step.
                </div>
            }

            @if (Model.ErrorMessage != null)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.ErrorMessage
                </div>
            }

            <!-- Step 1: Install app -->
            <div class="d-flex gap-3 mb-4">
                <span class="step-badge mt-1">1</span>
                <div>
                    <div class="fw-semibold mb-1" style="font-size:.9rem">Install an authenticator app</div>
                    <div class="text-muted" style="font-size:.82rem">
                        Use <strong>Microsoft Authenticator</strong>, <strong>Google Authenticator</strong>,
                        <strong>Authy</strong>, or any TOTP-compatible app.
                    </div>
                </div>
            </div>

            <!-- Step 2: Scan QR -->
            <div class="d-flex gap-3 mb-4">
                <span class="step-badge mt-1">2</span>
                <div class="w-100">
                    <div class="fw-semibold mb-2" style="font-size:.9rem">Scan this QR code</div>
                    @if (Model.QrBase64 != null)
                    {
                        <img src="data:image/png;base64,@Model.QrBase64"
                             alt="QR Code" style="width:160px;height:160px;border:1px solid #e5e7eb;border-radius:8px;display:block;margin-bottom:12px;" />
                    }
                    <div class="text-muted mb-1" style="font-size:.78rem">Or enter the key manually:</div>
                    <div class="key-box">@Model.ManualKey</div>
                </div>
            </div>

            <!-- Step 3: Enter code -->
            <div class="d-flex gap-3 mb-4">
                <span class="step-badge mt-1">3</span>
                <div class="w-100">
                    <div class="fw-semibold mb-2" style="font-size:.9rem">Enter the 6-digit code from your app</div>
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="text" asp-for="Code" class="form-control totp-input mb-3"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                               placeholder="000000" autofocus />
                        <button type="submit" class="btn-primary-full">
                            <i class="bi bi-check2-shield me-1"></i> Confirm & Enable MFA
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.DaysLeft.HasValue && Model.DaysLeft > 0)
            {
                <div class="text-center mt-2">
                    <a href="@(Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : "/")"
                       style="color:#9ca3af;font-size:.8rem;">
                        Skip for now (@Model.DaysLeft day@(Model.DaysLeft == 1 ? "" : "s") remaining)
                    </a>
                </div>
            }
        </div>
        <p class="text-center text-muted mt-3" style="font-size:.75rem;">Authorized access only</p>
    </div>
</body>
</html>
