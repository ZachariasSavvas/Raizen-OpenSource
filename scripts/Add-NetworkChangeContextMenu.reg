Windows Registry Editor Version 5.00

; ── Raizen: Add "Request Network Change" to all existing Raizen cascade menus ──
; Targets HKLM\SOFTWARE\Classes (system-wide, requires admin).
; Run as Administrator to import.

; ── All files (*) ────────────────────────────────────────────────────────────────
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\Raizen\shell\NetworkChange]
"MUIVerb"="Request Network Change"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\Raizen\shell\NetworkChange\command]
@="\"C:\\Program Files\\Raizen\\Tray\\Raizen.Endpoint.Tray.exe\" --network-change --config=\"C:\\ProgramData\\Raizen\\raizen-config.json\""

; ── Folders (Directory) ───────────────────────────────────────────────────────────
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\Raizen\shell\NetworkChange]
"MUIVerb"="Request Network Change"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\Raizen\shell\NetworkChange\command]
@="\"C:\\Program Files\\Raizen\\Tray\\Raizen.Endpoint.Tray.exe\" --network-change --config=\"C:\\ProgramData\\Raizen\\raizen-config.json\""

